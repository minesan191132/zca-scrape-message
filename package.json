{
    "name": "zca-scrape-message",
    "version": "1.0.0",
    "description": "Read-only Zalo Desktop message scraper (CDP-based) with scheduled and notification-triggered modes, plus a read-only MCP server over the scraped data.",
    "type": "module",
    "private": true,
    "scripts": {
        "bot:scrape": "tsx index.ts",
        "bot:watch": "tsx watch.ts",
        "zalo:debug": "tsx debug-zalo.ts",
        "export:excel": "tsx history/exportExcelCli.ts",
        "mcp": "tsx mcp/server.ts",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/minesan191132/zca-scrape-message.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "zalo",
        "scraper",
        "cdp",
        "mcp"
    ],
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.0",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^20.14.10",
        "tsx": "^4.19.0",
        "typescript": "^5.5.3"
    }
}
